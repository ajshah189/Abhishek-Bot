# ============================================================
# Personal AI Assistant — environment template
# Run: node backend/setup/setupWizard.js  to generate this
# ============================================================

# ── Telegram ──────────────────────────────────────────────
# Create your bot at t.me/BotFather → /newbot
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_WEBHOOK_URL=https://your-cloud-run-url/webhook
TELEGRAM_WEBHOOK_SECRET=your-random-secret

# ── Groq (free at console.groq.com) ───────────────────────
GROQ_API_KEY=your-groq-api-key
LLM_PROVIDER=groq

# ── Firebase Admin SDK ─────────────────────────────────────
# Project Settings → Service Accounts → Generate New Private Key
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id

# ── Firebase Web App (dashboard) ───────────────────────────
# Project Settings → Your apps → Web app → SDK config
VITE_FIREBASE_API_KEY=your-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:your-sender-id:web:your-app-id

# ── User identity ──────────────────────────────────────────
# Your name (bot will call you this)
USER_NAME=Your Name
# IANA timezone string
USER_TIMEZONE=Asia/Kolkata
# Your Telegram user ID — send /id to @userinfobot
OWNER_TELEGRAM_ID=your-telegram-user-id
VITE_USER_ID=your-telegram-user-id
# Your deployed dashboard URL (optional)
DASHBOARD_URL=https://your-project.web.app
VITE_API_BASE=https://your-cloud-run-url
VITE_VOICE_API_KEY=your-voice-api-key

# ── Voice API ──────────────────────────────────────────────
VOICE_API_KEY=your-voice-api-key

# ── Google Calendar (optional) ────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
